# =============================================================================
# Helix Guard: Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your private credentials.
# DO NOT COMMIT .env TO VERSION CONTROL.
# =============================================================================

# IBM Quantum Authentication (Optional - for future hardware experiments)
# Get your API key from https://quantum.ibm.com/account
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here

# IBM Quantum Instance (Hub/Group/Project or CRN format)
IBM_QUANTUM_INSTANCE=crn:v1:bluemix:public:quantum-computing:...

# IBM Quantum Auth URL (Default: cloud identity)
IBM_QUANTUM_URL=https://auth.quantum-computing.ibm.com/api

# Execution Mode: "simulation" (default) or "hardware"
QUANTUM_EXECUTION_MODE=simulation

